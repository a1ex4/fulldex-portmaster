# Cross-compiles pokemon-fulldex for aarch64 against Debian bullseye (glibc 2.31,
# GLIBCXX 3.4.28), so it runs on the older CFWs PortMaster supports. SDL2 and EGL are only
# linked against here; the device's own copies are used at run time.
FROM debian:bullseye
# (bullseye is end of life: its packages are on archive.debian.org now.)
RUN printf 'deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/* \
    && dpkg --add-architecture arm64 && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    g++-aarch64-linux-gnu gcc-aarch64-linux-gnu cmake ninja-build python3 python3-pil git curl \
    ca-certificates pkg-config patchelf file \
    libsdl2-dev:arm64 libegl-dev:arm64 zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
# SDL 2.30.9 to link against (fulldex calls SDL_RenderGeometry, newer than bullseye's 2.0.14).
# Never shipped: only its soname, libSDL2-2.0.so.0, is recorded in the program.
RUN curl -fsSL https://github.com/libsdl-org/SDL/releases/download/release-2.30.9/SDL2-2.30.9.tar.gz | tar xz -C /tmp \
    && printf 'set(CMAKE_SYSTEM_NAME Linux)\nset(CMAKE_SYSTEM_PROCESSOR aarch64)\nset(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)\nset(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)\nset(CMAKE_FIND_ROOT_PATH /opt/sdl2-arm64 /usr/aarch64-linux-gnu)\nset(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)\nset(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)\nset(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)\nset(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)\n' > /opt/aarch64.cmake \
    && cmake -S /tmp/SDL2-2.30.9 -B /tmp/sdl-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_TOOLCHAIN_FILE=/opt/aarch64.cmake -DCMAKE_INSTALL_PREFIX=/opt/sdl2-arm64 \
       -DSDL_STATIC=OFF -DSDL_TEST=OFF -DSDL_X11=OFF -DSDL_WAYLAND=OFF -DSDL_PULSEAUDIO=OFF \
       -DSDL_PIPEWIRE=OFF -DSDL_JACK=OFF -DSDL_SNDIO=OFF -DSDL_LIBSAMPLERATE=OFF -DSDL_DBUS=OFF -DSDL_IBUS=OFF \
    && ninja -C /tmp/sdl-build install && rm -rf /tmp/SDL2-2.30.9 /tmp/sdl-build
